{
  "name": "reviewops",
  "version": "1.0.0",
  "description": "GitHub Action that reviews pull requests with an AI model and posts inline comments.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && ncc build src/index.js -o dist --license licenses.txt",
    "eval": "node eval/run.mjs",
    "compare": "node eval/compare/compare.mjs"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "openai": "^7.28.0",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "markdown-it": "^15.0.2",
    "prettier": "^3.9.9",
    "yaml": "^2.9.1"
  }
}
